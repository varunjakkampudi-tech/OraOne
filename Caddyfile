# Caddy reverse proxy — single entry point for the whole stack.
# Automatic HTTPS via Let's Encrypt when CADDY_DOMAIN is a real public
# domain; falls back to plain HTTP on localhost for local testing.
#
# Routes:
#   /api/*  -> backend:8000
#   /*      -> frontend:8080 (web app)
{$CADDY_DOMAIN:localhost} {
	encode gzip zstd

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		# Belt-and-suspenders: backend/frontend already set their own security
		# headers; this ensures they're present even if a future route ever
		# skips one of those apps.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Clickjacking: the app is never meant to be framed. The embeddable chat
		# widget is a plain script (public/widget.js) that uses Shadow DOM and
		# does not need an iframe of this origin.
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		# No browser feature is used by the app. Microphone is not justified: the
		# "voice" references are telephony channel settings handled server-side.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		# script-src keeps 'unsafe-inline': the TanStack Start streaming bootstrap
		# is inline and its hash differs per route and per build, so sha256
		# hashes cannot be maintained here. style-src keeps 'unsafe-inline' for
		# React style props and style attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}
