# Web app configuration. Copy to .env.local for development.
# Leave VITE_API_BASE_URL empty to use same-origin /api. The Vite dev server
# proxies /api to the backend, and Caddy does the same in production.
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api requests.
API_PROXY_TARGET=http://localhost:8000
