# Production build config for the same-origin Caddy deployment.
# Auth is selected by the backend; Cognito secrets never belong here.

REACT_APP_ENV=production

# Caddy routes /api to FastAPI on the same HTTPS origin.
REACT_APP_API_URL=https://oraone.in
REACT_APP_AUTH_PROVIDER=cognito
REACT_APP_COGNITO_DOMAIN=https://ap-southeast-2cfhugatzr.auth.ap-southeast-2.amazoncognito.com
REACT_APP_COGNITO_CLIENT_ID=6nr1n019eiihlh89vpmu31p1im
REACT_APP_COGNITO_REDIRECT_URI=https://oraone.in/auth/callback
