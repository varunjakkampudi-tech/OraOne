# OraOne frontend — environment variable template.
# Copy to `.env` (local dev) and fill in real values. Only REACT_APP_*
# variables are ever bundled into the client — never put secrets here.

REACT_APP_ENV=development

# Backend API origin. Local dev default matches `uvicorn server:app --port 8000`.
REACT_APP_API_URL=http://localhost:8000
REACT_APP_AUTH_PROVIDER=self_hosted
REACT_APP_COGNITO_DOMAIN=
REACT_APP_COGNITO_CLIENT_ID=
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# Cognito public configuration is supplied by the approved production build
# process. Never put client secrets or OpenRouter credentials in this file.
