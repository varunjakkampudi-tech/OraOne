# OraOne backend — environment variable template.
# Copy to `.env` and fill in real values. Never commit `.env` (gitignored).
# See the root README for the authoritative setup and operations reference.

ENVIRONMENT=development

# ---- Identity provider ----
# Use self_hosted for local migration work. Production must use cognito after
# the user-pool/client and frontend OAuth callback have been configured.
AUTH_PROVIDER=self_hosted
COGNITO_USER_POOL_ID=
COGNITO_REGION=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_USERINFO_URL=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=https://oraone.in/auth/callback

# ---- Self-hosted migration auth (not the production identity provider) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_LEEWAY_SECONDS=60
JWT_ISSUER=oraone-api

# Local admin account seeded by migration 0044 (email/password you log in with).
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# ---- CORS — comma-separated exact origins; never `*` with credentials ----
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL (required — system of record; needs the pgvector extension) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME_PG=oraone

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/oraone
ALEMBIC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/oraone

# ---- Redis (optional — falls back to in-process cache when unset) ----
REDIS_URL=
ENTITLEMENTS_CACHE_BACKEND=inprocess

# ---- Object storage (optional — falls back to local disk under UPLOAD_DIR) ----
# Works with real AWS S3 (leave S3_ENDPOINT_URL unset) or any S3-compatible
# store — MinIO, Cloudflare R2, Backblaze B2 — by setting S3_ENDPOINT_URL.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=/tmp/oraone-uploads

# ---- Frontend base (used for email verification/reset links) ----
FRONTEND_URL=http://localhost:3000
RUN_BACKGROUND_WORKERS=false

# ---- Widget public URLs (optional) ----
# Only needed when the widget is served from a different public origin.
# With the Hostinger/Caddy deployment, same-origin `/api` routing is preferred.
# WIDGET_CDN_BASE: where /widget.js itself is served (defaults to FRONTEND_URL).
# WIDGET_API_BASE (or BACKEND_PUBLIC_URL / PUBLIC_BACKEND_URL / BACKEND_URL,
# first match wins): the backend origin embedded widgets call.
WIDGET_CDN_BASE=
WIDGET_API_BASE=


# ---- Google OAuth (optional — Google Drive integration) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ---- AI chat provider (required in production) ----
# OraOne's OpenAIProvider reads OPENAI_* ; point OPENAI_BASE_URL at OpenRouter
# (or leave unset to use OpenAI directly). OPENROUTER_SITE_URL/APP_NAME are
# also read directly (sent as HTTP-Referer/X-Title to OpenRouter) — there is
# no separate OPENROUTER_API_KEY, set OPENAI_API_KEY to your OpenRouter key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_OUTPUT_TOKENS=2048
OPENAI_MODEL=openai/gpt-5.5
# Pin every agent to one model regardless of its configured model name
AI_FORCE_MODEL=
OPENROUTER_SITE_URL=https://oraone.in
OPENROUTER_APP_NAME=OraOne
AI_ALLOW_MOCK=false

# ---- Embeddings (RAG / document + website-crawl ingestion) ----
# EMBEDDING_PROVIDER=hash needs no credentials (lexical-overlap vectors) and
# is a safe default. Switch to "bedrock" only once you have a working AWS
# Bedrock key with Titan model access — an invalid key fails ingestion loudly.
# AWS_REGION is also read as a fallback region for S3/SES if those are configured.
AWS_REGION=us-east-1
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024
BEDROCK_REGION=ap-southeast-2
AWS_BEARER_TOKEN_BEDROCK=

# ---- Twilio (optional — WhatsApp/SMS channel, app/services/channels/) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Billing (optional — Stripe; falls back to mock mode when unset) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (optional — falls back to log-only when nothing below is set) ----
# Provider order: SMTP (if SMTP_HOST is set) is tried first, then SES (if
# EMAIL_FROM is set), then log-only. SMTP has no sandbox recipient restriction,
# so it's the reliable option for a brand-new AWS account awaiting SES
# production access — e.g. point it at any real mailbox (Hostinger, Gmail, etc).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_USE_SSL=true uses implicit TLS (port 465); set to false for STARTTLS (port 587).
SMTP_USE_SSL=true

EMAIL_FROM=
SES_REGION=
