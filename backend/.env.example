# Backend configuration template.
# Copy to backend/.env and fill in local values. Never commit backend/.env.
# docs/guides/ENVIRONMENT.md describes every variable.

# ── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Authentication (self-hosted, passwordless email codes) ──────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Development only: allows POST /api/auth/dev-login (password sign-in for the
# seeded local accounts). Ignored and disabled outside ENVIRONMENT=development.
ALLOW_DEV_PASSWORD_LOGIN=false

# ── Database and cache ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oraone_admin:oraone_dev_password@localhost:5433/oraone
ALEMBIC_DATABASE_URL=postgresql+psycopg2://oraone_admin:oraone_dev_password@localhost:5433/oraone
REDIS_URL=redis://localhost:6379/0
ENTITLEMENTS_CACHE_BACKEND=redis
RUN_BACKGROUND_WORKERS=false

# ── AI provider: OpenRouter (the only provider) ─────────────────────────────
# Create a key at https://openrouter.ai. Without it, AI replies are unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: forces every agent to one model (useful for cost control).
AI_FORCE_MODEL=
# Embeddings for knowledge search. Uses OpenRouter when the key is set,
# otherwise a deterministic local fallback.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBED_DIM=1024

# ── Files ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Email (SMTP). Without SMTP_HOST, sign-in codes are logged as not sent. ─
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# ── Web origin ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5180
CORS_ORIGINS=http://localhost:5180
